# Conexão com o Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solo_leveling

# Chave usada para assinar os JWTs (obrigatória)
SECRET_KEY=troque-esta-chave

# Tempo de expiração do token de acesso, em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origens permitidas no CORS, separadas por vírgula
ALLOWED_ORIGINS=http://localhost:5173

# Chaves VAPID do Web Push (veja "Notificações" no README para gerar)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@example.com

# Fuso usado pelo scheduler de lembretes
SCHEDULER_TIMEZONE=America/Sao_Paulo

# false quando os lembretes vierem de um cron externo (ex. hospedagem que hiberna)
SCHEDULER_ENABLED=true

# Token exigido no header X-Cron-Secret de POST /push/dispatch
CRON_SECRET=

# true em produção: redireciona http->https e envia HSTS
FORCE_HTTPS=false

# Chave da API do Gemini (https://aistudio.google.com/apikey).
# Sem ela o Conselheiro do Sistema fica desativado; nunca coloque no frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Teto de mensagens do Conselheiro por usuário por dia (protege a cota gratuita)
COACH_MESSAGES_PER_DAY=40

# Rate limit por IP (429 quando excedido)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
